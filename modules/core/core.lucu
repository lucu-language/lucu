import "builtin:types"
import "control"

type u8 = types.u8
type u16 = types.u16
type u32 = types.u32
type u64 = types.u64

type uint = types.uint
type uptr = types.uptr
type usize = types.usize

type i8 = types.i8
type i16 = types.i16
type i32 = types.i32
type i64 = types.i64

type int = types.int
type iptr = types.iptr
type isize = types.isize

type bool = types.bool
type unit = types.unit

const true bool = types.true
const false bool = types.false

effect Yield[T] = {
   fun yield(t T)
}

handle control.Wrap[Yield] {
   fun wrap[A](a A) with Yield[A] = {
      -- yield(a)
   }
}

handle control.Map[Yield] {
   fun map[A, B](fun f(a A) B, fun body with Yield[A]) with Yield[B] = {
      -- perform body with Yield[A] { a ->
      --    yield(f(a))
      -- }
   }
}

handle control.CrossMap[Yield] {
   fun cross_map[A, B, C](
      fun f(lhs a, rhs B) C,
      fun as with Yield[A],
      fun bs with Yield[B],
   ) with Yield[C] = {
      -- perform as with Yield[A] { a ->
      --    perform bs with Yield[B] { b ->
      --       yield(f(a, b))
      --    }
      -- }
   }
}

handle control.FlatMap[Yield] {
   fun flat_map[A, B](fun f(a A) with Yield[B], fun body with Yield[A]) with Yield[B] = {
      -- perform body with Yield[A] { a ->
      --    f(a)
      -- }
   }
}
