import "builtin:regions"
import "core:io"
import "core:random"
import "core:fmt"

type Board[r] = struct(
    bytes ^@r []i8,
    stride size,
)

handle[r] fmt.ShowMultiline[Board[r]] {
    fun write_multiline(board Board[r]) with io.Sink Fail = {
        fmt.write("-")
        for(0, board.stride) { x ->
            fmt.write("--")
        }
        fmt.write("-")
        fmt.writeln

        for(0, board.stride) { y ->
            fmt.write("|")
            for(0, board.stride) { x ->
                fmt.write(if board.bytes[x + y * board.stride]^ == 1 then "[]" else "  ")
            }
            fmt.write("|")
            fmt.writeln
        }

        fmt.write("-")
        for(0, board.stride) { x ->
            fmt.write("--")
        }
        fmt.write("-")
    }
}

fun dec(n size, stride size) size = if n == 0 then stride - 1 else n - 1
fun inc(n size, stride size) size = if n == stride - 1 then 0 else n + 1

fun board_clear[mut r](board Board[r]) = {
    for(0, board.stride) { y ->
        for(0, board.stride) { x ->
            board.bytes[x + y * board.stride]^ = 0
        }
    }
}

fun board_next[a, mut b](old Board[a], new Board[b]) = {
    assert(old.stride == new.stride, "strides are different")
    let stride = old.stride

    for(0, stride) { y ->
        for(0, stride) { x ->
            let neighbors ^size = use regions.ref(0)

            if old.bytes[dec(x, stride) + dec(y, stride) * stride]^ == 1 then neighbors^ += 1
            if old.bytes[x + dec(y, stride) * stride]^ == 1 then neighbors^ += 1
            if old.bytes[inc(x, stride) + dec(y, stride) * stride]^ == 1 then neighbors^ += 1
            if old.bytes[dec(x, stride) + y * stride]^ == 1 then neighbors^ += 1
            if old.bytes[inc(x, stride) + y * stride]^ == 1 then neighbors^ += 1
            if old.bytes[dec(x, stride) + inc(y, stride) * stride]^ == 1 then neighbors^ += 1
            if old.bytes[x + inc(y, stride) * stride]^ == 1 then neighbors^ += 1
            if old.bytes[inc(x, stride) + inc(y, stride) * stride]^ == 1 then neighbors^ += 1

            new.bytes[x + y * stride]^ = if old.bytes[x + y * stride]^ == 1 {
                if neighbors^ == 2 {
                    1
                } else if neighbors^ == 3 {
                    1
                } else {
                    0
                }
            } else if neighbors^ == 3 {
                1
            } else {
                0
            }
        }
    }
}

fun _alloca_board[r](stride size, bytes ^@r []i8) Board[r] = {
    let board ^Board[r] = use regions.ref(0)
    board.bytes^ = bytes
    board.stride^ = stride
    board^
}

fun alloca_board(stride size, fun body[mut r](board Board[r])) = {
    let bytes ^[]i8 = use regions.alloca(stride * stride)
    body(_alloca_board(stride, bytes))
}

fun main with Div io.StdIo random.Rng = #inline {
    let stride size = 32

    use io.stdin
    use io.stdout

    -- create buffers
    let board_a = use alloca_board(stride)
    let board_b = use alloca_board(stride)

    -- init state
    if true {
        -- random
        random.fill_bytes(board_a.bytes)
        for(0, len(board_a.bytes)) { i ->
            board_a.bytes[i]^ &= 1
        }
    } else {
        -- glider
        board_clear(board_a)
        board_a.bytes[0 + 0 * stride]^ = 1
        board_a.bytes[1 + 1 * stride]^ = 1
        board_a.bytes[2 + 1 * stride]^ = 1
        board_a.bytes[0 + 2 * stride]^ = 1
        board_a.bytes[1 + 2 * stride]^ = 1
    }

    loop {
        try fmt.write_multiline(board_a)
        try fmt.writeln
        io.flush
        discard io.skip_line
        board_next(board_a, board_b)

        try fmt.write_multiline(board_b)
        try fmt.writeln
        io.flush
        discard io.skip_line
        board_next(board_b, board_a)
    }
}
