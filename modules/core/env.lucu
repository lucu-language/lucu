--# Command line arguments iterator
effect Args = {
    fun has_next_arg bool
    fun next_arg ?cstr[static,]
    fun remaining_args with Yield[cstr[static,],]
}

--# Environment variables map
effect Environ = {
    fun get[r](key str[r,]) ?cstr[static,]
}

fun contains[r](key str[r,]) bool with Environ = get(key) != none
