import "builtin:regions"

effect Source = {
    fun read[#write r](bytes str[r,]) size
}

fun skip_line size with Source = {
    let total ^size = use regions.ref(0)
    let buf ^[1]i8 = use regions.ref(---)
    handle unfounded loop {
        if read(buf[..]) == 0 then raise
        total^ += 1
        if buf[0]^ == 10 then raise
    }
    total^
}

fun read_line[#write r](bytes str[r,]) size with Source = {
    let total ^size = use regions.ref(0)
    let buf ^[1]i8 = use regions.ref(---)
    handle unfounded loop {
        if read(buf[..]) == 0 then raise
        let char = buf[0]^
        bytes[total^]^ = char
        total^ += 1
        if char == 10 then raise
        if total^ == len(bytes) then raise
    }
    total^
}

effect Sink = {
    fun write[r](bytes str[r,]) size
    fun flush
}

fun write_all[r](bytes str[r,]) with Fail = {
    todo("write_all")
}

fun writeln size with Sink = {
    let buf ^[1]i8 = use regions.ref([10])
    write(buf[..])
}

fun write_int(n int) with Sink = {
    let buf ^[21]i8 = use regions.ref(---)

    let remaining = use regions.ref(abs(n))

    let start size = handle {
        let current ^size = use regions.ref(20)
        unfounded loop {
            buf[current^]^ = '0' + #trunc (remaining^ % 10)
            remaining^ /= 10
            if remaining^ == 0 {
                yeet current^
            }
            current^ -= 1
        }
        unreachable
    }

    -- FIXME: write_all
    discard write(if n < 0 {
        buf[start - 1]^ = '-'
        buf[start - 1..]
    } else {
        buf[start..]
    })
}

fun print[r](bytes str[r,]) with StdIo = {
    use stdout
    -- FIXME: write_all
    discard write(bytes)
}

fun eprint[r](bytes str[r,]) with StdIo = {
    use stderr
    -- FIXME: write_all
    discard write(bytes)
}

fun println with StdIo = {
    use stdout
    -- FIXME: write_all
    discard writeln
}

fun eprintln with StdIo = {
    use stderr
    -- FIXME: write_all
    discard writeln
}

fun print_int(n int) with StdIo = {
    use stdout
    write_int(n)
}

fun eprint_int(n int) with StdIo = {
    use stderr
    write_int(n)
}

effect StdIo = {
    fun stdin(fun body with Source)
    fun stdout(fun body with Sink)
    fun stderr(fun body with Sink)
}

fun buffered_sink[mut r](buffer str[r,], fun body with Sink) with Sink = {
    let current ^size = use regions.ref(0)
    -- FIXME: deal with super write not writing everything
    -- (we need a Queue probably)
    handle body with Sink {
        fun write[r](bytes str[r,]) size = {
            for(0, len(bytes)) { i ->
                if current^ == len(buffer) {
                    discard write(buffer)
                    current^ = 0
                }
                buffer[current^]^ = bytes[i]^
                current^ += 1
            }
            len(bytes)
        }
        fun flush = {
            if current^ > 0 {
                discard write(buffer[0..current^])
                current^ = 0
            }
            flush
        }
    }
}
