import "types"
import "regions"

type u8 = types.u8
type u16 = types.u16
type u32 = types.u32
type u64 = types.u64

type uint = types.uint
type uptr = types.uptr
type usize = types.usize

type i8 = types.i8
type i16 = types.i16
type i32 = types.i32
type i64 = types.i64

type int = types.int
type iptr = types.iptr
type isize = types.isize

type bool = types.bool
type unit = types.unit

const true bool = types.true
const false bool = types.false

type nullptr = types.nullptr

type static_str = ^@static []u8

-- regions

region static = regions.static
region heap = regions.heap

effect Read[r] = regions.Read[r]
effect Write[r] = regions.Write[r]

-- fun ref[T, U](val T, fun body(ptr ^mut T) U) U
-- 	= regions.ref[T, U](val, body)

-- source location

effect Location = {
	fun path static_str
	fun line uint
	fun column uint
}

handle Location {
	fun path static_str = #intrinsic
	fun line uint = #intrinsic
	fun column uint = #intrinsic
}

-- world

effect World
	= #intrinsic

fun link[LIB static_str, E effect](fun body with E) with World
	= #intrinsic

fun asm[ASSEMBLY static_str, CONSTRAINTS static_str, T, U](t T) U with World
	= #intrinsic

fun asm_pure[ASSEMBLY static_str, CONSTRAINTS static_str, T, U](t T) U
	= #intrinsic

fun syscall0(nr uptr) uptr
	with World
	= asm["syscall", "={rax},{rax},~{rcx},~{r11},~{memory}", [1]uptr, uptr]([nr])
fun syscall1(nr uptr, arg1 uptr) uptr
	with World
	= asm["syscall", "={rax},{rax},{rdi},~{rcx},~{r11},~{memory}", [2]uptr, uptr]([nr, arg1])
fun syscall2(nr uptr, arg1 uptr, arg2 uptr) uptr
	with World
	= asm["syscall", "={rax},{rax},{rdi},{rsi},~{rcx},~{r11},~{memory}", [3]uptr, uptr]([nr, arg1, arg2])
fun syscall3(nr uptr, arg1 uptr, arg2 uptr, arg3 uptr) uptr
	with World
	= asm["syscall", "={rax},{rax},{rdi},{rsi},{rdx},~{rcx},~{r11},~{memory}", [4]uptr, uptr]([nr, arg1, arg2, arg3])
fun syscall4(nr uptr, arg1 uptr, arg2 uptr, arg3 uptr, arg4 uptr) uptr
	with World
	= asm["syscall", "={rax},{rax},{rdi},{rsi},{rdx},{r10},~{rcx},~{r11},~{memory}", [5]uptr, uptr]([nr, arg1, arg2, arg3, arg4])
fun syscall5(nr uptr, arg1 uptr, arg2 uptr, arg3 uptr, arg4 uptr, arg5 uptr) uptr
	with World
	= asm["syscall", "={rax},{rax},{rdi},{rsi},{rdx},{r10},{r8},~{rcx},~{r11},~{memory}", [6]uptr, uptr]([nr, arg1, arg2, arg3, arg4, arg5])
fun syscall6(nr uptr, arg1 uptr, arg2 uptr, arg3 uptr, arg4 uptr, arg5 uptr, arg6 uptr) uptr
	with World
	= asm["syscall", "={rax},{rax},{rdi},{rsi},{rdx},{r10},{r8},{r9},~{rcx},~{r11},~{memory}", [7]uptr, uptr]([nr, arg1, arg2, arg3, arg4, arg5, arg6])

fun syscall_read(file uptr, buf ^mut []u8) usize with World = {
	#trunc syscall3(0, file, #transmute text[0], #ext len(text))
}

fun syscall_write(file uptr, buf ^[]u8) usize with World = {
	#trunc syscall3(1, file, #transmute buf[0], #ext len(buf))
}

fun syscall_exit(code uptr) ! with World = {
	syscall1(60, code)
	unreachable
}

-- printing

fun print_int(n int) = {
	let buf = use ref[[21]u8](---)

	let remaining = use ref(abs(n))

	let start = catch {
		for(21, 1) { current ->
			let digit u8 = '0' + #trunc (remaining^ % 10)
			remaining^ /= 10

			buf[current]^ = digit

			if remaining^ == 0 {
				raise current
			}
		}
		unreachable
	}

	if n < 0 {
		buf[start - 1] = '-'
		print_str(buf[start - 1..21])
	} else {
		print_str(buf[start..21])
	}
}

fun print_str(buf ^[]u8)
	= #intrinsic

-- control flow

effect Div
	= #intrinsic

fun loop(fun body) ! with Div
	= #intrinsic

fun unfounded[T](fun body T with Div) T
	= #intrinsic

fun for(from usize, to usize, fun body(n usize)) = {
	if to >= from {
		let current = use ref(from)
		catch unfounded loop {
			if current^ == to then raise
			body(current^)
			current^ += 1
		}
	} else {
		let current = use ref(from - 1)
		catch unfounded loop {
			body(current^)
			current^ -= 1
			if current^ == to then raise
		}
	}
}

fun unreachable !
	= #intrinsic

-- other utils

fun len[R region, T](slice ^@R []T) usize
	= #intrinsic

fun abs(n int) int
	= #intrinsic

