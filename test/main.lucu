fun hoohaa = {
    let n = use regions.ref[int, unit](1)
    n^ <<= 3
    trace_int(n^)
    traceln
}

fun _start ! with World = {
    hoohaa
    assert(2 + 2 == 5, "damn")
    trace_int(420)
    traceln
    trace_int(69)
    traceln
    trace_int(-10)
    traceln
    trace("Hello, World!")
    traceln
    conway.main
    syscall_exit(0)
    unreachable
}

