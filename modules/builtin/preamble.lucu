-- integer types

type u8 = #intrinsic
type u16 = #intrinsic
type u32 = #intrinsic
type u64 = #intrinsic

type uint = #intrinsic
type uptr = #intrinsic
type usize = #intrinsic

type i8 = #intrinsic
type i16 = #intrinsic
type i32 = #intrinsic
type i64 = #intrinsic

type int = #intrinsic
type iptr = #intrinsic
type isize = #intrinsic

-- other types

type bool = #intrinsic
type unit = #intrinsic

-- regions

effect Read[R region]
	= #intrinsic

effect Write[R region]
	= #intrinsic

fun local[T, U](
	val T,
	fun body[R region](ptr ^@R T) U with Read[R] Write[R]
) U = #intrinsic

fun alloca[T, U](
	len usize,
	fun body[R region](slice ^@R []T) U with Read[R] Write[R]
) U = #intrinsic

-- slices

effect Slice[T] = {
	fun len(slice T) usize
}

handle[E, R region] Slice[^@R []E] {
	fun len(slice ^@R []E) usize
		= #intrinsic
}
handle[E, R region] Slice[^@R [:0]E] with Read[R] {
	fun len(slice ^@R [:0]E) usize
		= #intrinsic
}

-- handle[E,           N usize] Slice[    [N  ]E]
-- handle[E,           N usize] Slice[    [N:0]E]
-- handle[E, R region, N usize] Slice[^@R [N  ]E]
-- handle[E, R region, N usize] Slice[^@R [N:0]E]

-- printing

fun print_int(n int) = {
	mut buf [21]u8 = ---

	mut remaining = if n < 0 then -n else n

	mut start = try {
		for(20, 0) { current ->
			let digit u8 = '0' + #cast (remaining % 10)
			remaining /= 10

			buf[current] = digit

			if remaining == 0 {
				break current
			}
		}
		break 1
	}

	if n < 0 {
		start -= 1
		buf[start] = '-'
	}

	print_str(&buf[start..21])
}

fun print_str[R region](buf ^@R []u8) with Read[R]
	= #intrinsic

-- divergence

effect Div
	= #intrinsic

fun loop(fun body) ! with Div
	= #intrinsic

fun unfounded[T](fun body T with Div) T
	= #intrinsic

fun for(from usize, to usize, fun body(n usize)) = {
	let rising = to > from
	mut current = from
	try unfounded loop {
		if current == to then break
		body(current)

		if rising {
			current += 1
		} else {
			current -= 1
		}
	}
}
