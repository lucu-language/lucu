import "types"
import "regions"

type u8 = types.u8
type u16 = types.u16
type u32 = types.u32
type u64 = types.u64

type uint = types.uint
type uptr = types.uptr
type usize = types.usize

type i8 = types.i8
type i16 = types.i16
type i32 = types.i32
type i64 = types.i64

type int = types.int
type iptr = types.iptr
type isize = types.isize

type bool = types.bool
type unit = types.unit

const true bool = types.true
const false bool = types.false

-- regions

effect Read[r] = regions.Read[r]
effect Write[r] = regions.Write[r]

-- printing

fun print_int(n int) = {
	mut buf [21]u8 = ---

	mut remaining = if n < 0 then -n else n

	mut start = try {
		for(20, 0) { current ->
			let digit u8 = '0' + #cast (remaining % 10)
			remaining /= 10

			buf[current] = digit

			if remaining == 0 {
				break current
			}
		}
		break 1
	}

	if n < 0 {
		start -= 1
		buf[start] = '-'
	}

	print_str(&buf[start..21])
}

fun print_str(buf ^[]u8)
	= #intrinsic

-- divergence

effect Div
	= #intrinsic

fun loop(fun body) ! with Div
	= #intrinsic

fun unfounded[T](fun body T with Div) T
	= #intrinsic

fun for(from usize, to usize, fun body(n usize)) = {
	let rising = to > from
	mut current = from
	try unfounded loop {
		if current == to then break
		body(current)

		if rising {
			current += 1
		} else {
			current -= 1
		}
	}
}
