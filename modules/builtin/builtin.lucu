import "types"
import "regions"

type u8 = types.u8
type u16 = types.u16
type u32 = types.u32
type u64 = types.u64

type uint = types.uint
type uaddr = types.uaddr
type usize = types.usize

type i8 = types.i8
type i16 = types.i16
type i32 = types.i32
type i64 = types.i64

type int = types.int
type addr = types.addr
type size = types.size

type bool = types.bool
type unit = types.unit

const true bool = types.true
const false bool = types.false

type nullptr = types.nullptr

type static_str = ^@static []u8

-- regions

region static = regions.static
region heap = regions.heap

effect Read[r] = regions.Read[r]
effect Write[r] = regions.Write[r]

-- fun ref[T, U](val T, fun body(ptr ^mut T) U) U
-- 	= regions.ref[T, U](val, body)

-- source location

effect Location = {
	fun path static_str
	fun line uint
	fun column uint
}

handle Location {
	fun path static_str = #intrinsic
	fun line uint = #intrinsic
	fun column uint = #intrinsic
}

-- world

effect World
	= #intrinsic

fun link[LIB static_str, E effect](fun body with E) with World
	= #intrinsic

fun asm[ASSEMBLY static_str, CONSTRAINTS static_str, T, U](t T) U with World
	= #intrinsic

fun asm_pure[ASSEMBLY static_str, CONSTRAINTS static_str, T, U](t T) U
	= #intrinsic

fun syscall0(nr addr) addr
	with World
	= asm["syscall", "={rax},{rax},~{rcx},~{r11},~{memory}", [1]addr, addr]([nr])
fun syscall1(nr addr, arg1 addr) addr
	with World
	= asm["syscall", "={rax},{rax},{rdi},~{rcx},~{r11},~{memory}", [2]addr, addr]([nr, arg1])
fun syscall2(nr addr, arg1 addr, arg2 addr) addr
	with World
	= asm["syscall", "={rax},{rax},{rdi},{rsi},~{rcx},~{r11},~{memory}", [3]addr, addr]([nr, arg1, arg2])
fun syscall3(nr addr, arg1 addr, arg2 addr, arg3 addr) addr
	with World
	= asm["syscall", "={rax},{rax},{rdi},{rsi},{rdx},~{rcx},~{r11},~{memory}", [4]addr, addr]([nr, arg1, arg2, arg3])
fun syscall4(nr addr, arg1 addr, arg2 addr, arg3 addr, arg4 addr) addr
	with World
	= asm["syscall", "={rax},{rax},{rdi},{rsi},{rdx},{r10},~{rcx},~{r11},~{memory}", [5]addr, addr]([nr, arg1, arg2, arg3, arg4])
fun syscall5(nr addr, arg1 addr, arg2 addr, arg3 addr, arg4 addr, arg5 addr) addr
	with World
	= asm["syscall", "={rax},{rax},{rdi},{rsi},{rdx},{r10},{r8},~{rcx},~{r11},~{memory}", [6]addr, addr]([nr, arg1, arg2, arg3, arg4, arg5])
fun syscall6(nr addr, arg1 addr, arg2 addr, arg3 addr, arg4 addr, arg5 addr, arg6 addr) addr
	with World
	= asm["syscall", "={rax},{rax},{rdi},{rsi},{rdx},{r10},{r8},{r9},~{rcx},~{r11},~{memory}", [7]addr, addr]([nr, arg1, arg2, arg3, arg4, arg5, arg6])

fun syscall_read(file addr, buf ^mut []u8) size with World = {
	#trunc syscall3(0, file, #transmute buf[0], #ext len[u8,](buf))
}

fun syscall_write(file addr, buf ^[]u8) size with World = {
	#trunc syscall3(1, file, #transmute buf[0], #ext len[u8,](buf))
}

fun syscall_exit(code addr) ! with World = {
	discard syscall1(60, code)
	unreachable
}

-- printing

fun apply(val size, fun body(val size)) = body(val)

fun print_int(n int) = {
	let buf = use regions.ref[[21]u8, unit](---)

	let remaining = use regions.ref[int, unit](abs(n))

	let start = use apply(catch {
		let current = use regions.ref[size, size](20)
		unfounded loop {
			buf[current^]^ = '0' + #trunc (remaining^ % 10)
			remaining^ /= 10
			if remaining^ == 0 {
				raise current^
			}
			current^ -= 1
		}
	})

	print_str(if n < 0 {
		buf[start - 1]^ = '-'
		buf[start - 1..]
	} else {
		buf[start..]
	})
}

fun wait with World = {
	let buf = use regions.ref[[1]u8, unit](---)
	catch unfounded loop {
		if syscall_read(0, buf[..]) == 0 then raise
		if buf[0]^ == 10 then raise
	}
}

fun print_str(buf ^[]u8) = {
	trace(buf)
	print_ln
}

fun print_ln = {
	let buf = use regions.ref[[1]u8, unit]([10])
	trace(buf[..])
}

fun trace(buf ^[]u8)
	= #intrinsic

-- control flow

effect Div
	= #intrinsic

fun loop(fun body) ! with Div
	= #intrinsic

fun unfounded(fun body ! with Div) !
	= #intrinsic

fun for(from size, to size, fun body(n size)) = {
	if to >= from {
		let current = use regions.ref[size, unit](from)
		catch unfounded loop {
			if current^ == to then raise
			body(current^)
			current^ += 1
		}
	} else {
		let current = use regions.ref[size, unit](from - 1)
		catch unfounded loop {
			body(current^)
			current^ -= 1
			if current^ == to then raise
		}
	}
}

fun unreachable !
	= #intrinsic

-- other utils

fun len[T](slice ^[]T) size
	= #intrinsic

fun abs(n int) int = if n >= 0 then n else -n

