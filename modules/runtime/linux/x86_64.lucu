import "builtin:regions"
import "core:env"
import "linux:"
import "linux:core"
import "main:"

fun handle_syscall_raw(fun body with linux.SyscallRaw) with World = #inline {
    handle body with linux.SyscallRaw {
        fun syscall(nr addr, arg1 addr, arg2 addr, arg3 addr, arg4 addr, arg5 addr, arg6 addr) addr
            = asm[
                "syscall",
                "={rax},{rax},{rdi},{rsi},{rdx},{r10},{r8},{r9},~{rcx},~{r11},~{memory}",
                [7]addr,
                addr,
            ]([nr, arg1, arg2, arg3, arg4, arg5, arg6])
    }
}

fun handle_syscall_nr(fun body with linux.SyscallNR) = #inline {
    handle body with linux.SyscallNR {
        fun nr_read addr = 0
        fun nr_write addr = 1
        fun nr_exit addr = 60
        fun nr_exit_group addr = 231
        fun nr_getrandom addr = 318
    }
}

fun handle_args(argc size, argv cstrs, fun body with env.Args) = #inline {
    let current ^size = use regions.ref(0)
    handle body with env.Args {
        fun peek_arg ?cstr[static] = {
            if current^ < argc {
                some(argv[current^]^)
            } else {
                none
            }
        }
        fun skip_arg = {
            current^ += 1
        }
        fun remaining_args with Yield[cstr[static]] = {
            unfounded while(current^ < argc) {
                let arg = argv[current^]^
                current^ += 1
                yield(arg)
            }
        }
    }
}

fun handle_environ(envp cstrs, fun body with env.Environ) = #inline {
    handle body with env.Environ {
        fun get[r](key str[r]) ?cstr[static] = {
            let current ^size = use regions.ref(0)
            handle unfounded loop {
                let next = envp[current^]^
                current^ += 1

                if next == 0 {
                    raise none
                }

                if strlen(next) > len(key) {
                    if next[len(key)]^ == '=' {
                        if str_eq(key, next[..len(key)]) {
                            raise some(next[len(key) + 1..])
                        }
                    }
                }
            }
        }
    }
}

fun __entry(argc size, argv cstrs, envp cstrs) ! with World Div = {
    {
        use handle_syscall_raw
        use handle_syscall_nr
        use linux.handle_syscall
        use core.handle_stdio
        use core.handle_rng

        use handle_args(argc, argv)
        use handle_environ(envp)

        main.main
        linux.exit_group(0)
    }
    unreachable
}

type cstrs = ^@static [:0]cstr[static]

type Args = struct(
    argc int,
    argv0 cstr[static],
)

fun __start ! with World Div = {
    asm["", "{rbp}", int, unit](0)
    let rsp = asm_pure["", "={rsp},{rsp}", ^@static Args, ^@static Args](---)
    let argc size = #trunc rsp.argc^
    let argv cstrs = #transmute rsp.argv0
    let envp cstrs = #transmute argv[argc + 1]
    __entry(argc, argv, envp)
}
