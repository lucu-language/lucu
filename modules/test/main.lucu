import "core:io"
import "core:control"
import "builtin:ops"
import "libc:types" c
import "libc:program"

type Id[T] = T

type Test1 = Id[u32]

type Apply[M[_], T] = M[T]

type Test2 = Apply[Id, u32]

effect YieldABCD[A, B, C, D] = Yield[A] Yield[B] Yield[C] Yield[D]

effect Yield1 = Yield[u32]
effect Yield2 = Yield[u32] Yield[u64]
effect Yield3 = Yield[u32] Yield[Test1] Yield[Test2]
effect Yield4 = YieldABCD[u64, u64, u64, u64]

effect Empty = ;

type CString[r] = c.string[r]

type Slice[T, r] = ^@r []T

fun test(param ^u8) = {}

