import "builtin:c"
import "core:io"

fun writeln with io.Sink Fail = #inline io.writeln

effect Show[T] = {
    fun write(t T) with io.Sink Fail
}

effect ShowMultiline[T] = {
    fun write_multiline(t T) with io.Sink Fail
}

handle[r] Show[str[r]] {
    fun write(s str[r]) with io.Sink Fail = {
        io.write_all(s)
    }
}

handle Show[int] {
    fun write(i int) with io.Sink Fail = {
        io.write_int(i)
    }
}

handle Show[bool] {
    fun write(b bool) with io.Sink Fail = {
        write(if b then "true" else "false")
    }
}

handle[r] Show[cstr[r]] {
    fun write(s cstr[r]) with io.Sink Fail = {
        write(cstr_to_str(s))
    }
}

handle[r] Show[c.str[r]] {
    fun write(s c.str[r]) with io.Sink Fail = {
        write(cstr_to_str[r,](#transmute s))
    }
}

handle Show[SourceLocation] {
    fun write(loc SourceLocation) with io.Sink Fail = {
        write(loc.path)
        write(":")
        write(loc.line)
        write(":")
        write(loc.column)
    }
}
