import "core:io"

effect SyscallNR = {
    fun nr_read addr
    fun nr_write addr
    fun nr_exit addr
    fun nr_getrandom addr
}

effect SyscallRaw = {
    fun syscall(nr addr, arg1 addr, arg2 addr, arg3 addr, arg4 addr, arg5 addr, arg6 addr) addr
}

effect Syscall = {
    fun read[#write r](file addr, buf str[r,]) size
    fun write[r](file addr, buf str[r,]) size
    fun exit(code addr) !
    -- TODO: flags
    fun getrandom[#write r](buf str[r,]) size
}

fun with_syscall(fun body with Syscall) with SyscallNR SyscallRaw = #inline {
    handle body with Syscall {
        fun read[#write r](file addr, buf str[r,]) size = {
            #trunc syscall(nr_read, file, #transmute buf[0], #ext len(buf), ---, ---, ---)
        }
        fun write[r](file addr, buf str[r,]) size = {
            #trunc syscall(nr_write, file, #transmute buf[0], #ext len(buf), ---, ---, ---)
        }
        fun exit(code addr) ! = {
            discard syscall(nr_exit, code, ---, ---, ---, ---, ---)
            unreachable
        }
        fun getrandom[#write r](buf str[r,]) size = {
            #trunc syscall(nr_getrandom, #transmute buf[0], #ext len(buf), 0, ---, ---, ---)
        }
    }
}

fun stdio(fun body with io.StdIo) with Syscall = #inline handle body with io.StdIo {
    fun stdin(fun body with io.Source) = handle body with io.Source {
        fun read[#write r](bytes str[r,]) size = read(0, bytes)
    }
    fun stdout(fun body with io.Sink) = handle body with io.Sink {
        fun write[r](bytes str[r,]) size = write(1, bytes)
        fun flush = {}
    }
    fun stderr(fun body with io.Sink) = handle body with io.Sink {
        fun write[r](bytes str[r,]) size = write(2, bytes)
        fun flush = {}
    }
}
