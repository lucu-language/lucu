import "core:env"
import "os:linux"
import "main:main"
import "builtin:regions"

fun with_syscall_raw(fun body with linux.SyscallRaw) with World = #inline {
    handle body with linux.SyscallRaw {
        fun syscall(nr addr, arg1 addr, arg2 addr, arg3 addr, arg4 addr, arg5 addr, arg6 addr) addr
            = asm[
                "syscall",
                "={rax},{rax},{rdi},{rsi},{rdx},{r10},{r8},{r9},~{rcx},~{r11},~{memory}",
                [7]addr,
                addr,
            ]([nr, arg1, arg2, arg3, arg4, arg5, arg6])
    }
}

fun with_syscall_nr(fun body with linux.SyscallNR) = #inline {
    handle body with linux.SyscallNR {
        fun nr_read addr = 0
        fun nr_write addr = 1
        fun nr_exit addr = 60
        fun nr_getrandom addr = 318
    }
}

fun with_args(argc size, argv cstrs, fun body with env.Args) = #inline {
    let current ^size = use regions.ref(0)
    handle body with env.Args {
        fun has_next_arg bool = current^ < argc
        fun next_arg ?cstr[static,] = {
            if current^ < argc {
                let arg = argv[current^]^
                current^ += 1
                some(arg)
            } else {
                none
            }
        }
        fun remaining_args with Yield[cstr[static,],] = {
            unfounded while(current^ < argc) {
                let arg = argv[current^]^
                current^ += 1
                yield(arg)
            }
        }
    }
}

fun with_environ(envp cstrs, fun body with env.Environ) = #inline {
    handle body with env.Environ {
        fun get[r](key str[r,]) ?cstr[static,] = {
            let current ^size = use regions.ref(0)
            handle unfounded loop {
                let next = envp[current^]^
                current^ += 1

                if next == 0 {
                    raise none
                }

                if strlen(next) > len(key) {
                    if next[len(key)]^ == '=' {
                        if str_eq(key, #transmute next[..len(key)]) {
                            raise some(next[len(key) + 1..])
                        }
                    }
                }
            }
        }
    }
}

fun entry(argc size, argv cstrs, envp cstrs) ! with World Div = {
    {
        use with_syscall_raw
        use with_syscall_nr
        use linux.with_syscall
        use linux.stdio

        use with_args(argc, argv)
        use with_environ(envp)

        main.main
        linux.exit(0)
    }
    unreachable
}

type cstrs = ^@static [:0]cstr[static,]

type Args = struct(
    argc int,
    argv0 cstr[static,],
)

fun _start ! with World Div = {
    asm["", "{rbp}", int, unit](0)
    let rsp = asm_pure["", "={rsp},{rsp}", ^@static Args, ^@static Args](---)
    let argc size = #trunc rsp.argc^
    let argv cstrs = #transmute rsp.argv0
    let envp cstrs = #transmute argv[argc + 1]
    entry(argc, argv, envp)
}
