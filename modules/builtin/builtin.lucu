import "types"
import "regions"

type u8 = types.u8
type u16 = types.u16
type u32 = types.u32
type u64 = types.u64

type uint = types.uint
type uptr = types.uptr
type usize = types.usize

type i8 = types.i8
type i16 = types.i16
type i32 = types.i32
type i64 = types.i64

type int = types.int
type iptr = types.iptr
type isize = types.isize

type bool = types.bool
type unit = types.unit

const true bool = types.true
const false bool = types.false

-- regions

effect Read[r] = regions.Read[r]
effect Write[r] = regions.Write[r]

-- printing

fun print_int(n int) = {
	let buf = use ref[[21]u8](---)

	let remaining = use ref(if n < 0 then -n else n)

	let start = perform {
		for(20, 0) { current ->
			let digit u8 = '0' + #trunc (remaining^ % 10)
			remaining^ /= 10

			buf[current]^ = digit

			if remaining^ == 0 {
				return current
			}
		}
		return 1
	}

	if n < 0 {
		buf[start - 1] = '-'
		print_str(buf[start - 1..21])
	} else {
		print_str(buf[start..21])
	}
}

fun print_str(buf ^[]u8)
	= #intrinsic

-- divergence

effect Div
	= #intrinsic

fun loop(fun body) ! with Div
	= #intrinsic

fun unfounded[T](fun body T with Div) T
	= #intrinsic

fun for(from usize, to usize, fun body(n usize)) = {
	let rising = to > from
	let current = use ref(from)
	perform unfounded loop {
		if current^ == to then return
		body(current^)

		if rising {
			current^ += 1
		} else {
			current^ -= 1
		}
	}
}

-- other utils

-- USAGE:
-- ```
-- use defer(...)
-- ...
-- ```
fun defer[T](fun deferred unit, fun body T) T = {
	let t = body
	deferred
	t
}
