import "builtin:regions"

effect Source = {
    fun read[#write r](bytes str[r,]) size
}

fun skip_line size with Source = {
    let total ^size = use regions.ref(0)
    let buf ^[1]i8 = use regions.ref(---)
    handle unfounded loop {
        if read(buf[..]) == 0 then raise
        total^ += 1
        if buf[0]^ == 10 then raise
    }
    total^
}

fun read_line[#write r](bytes str[r,]) size with Source = {
    let total ^size = use regions.ref(0)
    let buf ^[1]i8 = use regions.ref(---)
    handle unfounded loop {
        if read(buf[..]) == 0 then raise
        let char = buf[0]^
        bytes[total^]^ = char
        total^ += 1
        if char == 10 then raise
        if total^ == len(bytes) then raise
    }
    total^
}

effect Sink = {
    fun write[r](bytes str[r,]) size
    fun flush
}

-- FIXME: all these currently need to be #inline,
-- so that 'fail' jumps within the same function,
-- but we don't want this in the end

fun write_all[r](bytes str[r,]) with Sink Fail = #inline {
    let remaining = use regions.ref(bytes)
    unfounded until(len(remaining^) == 0) {
        let written = write(remaining^)
        if written == 0 then fail
        remaining^ = remaining^[written..]
    }
}

fun writeln with Sink Fail = #inline {
    let buf ^[1]i8 = use regions.ref([10])
    write_all(buf[..])
}

fun write_int(n int) with Sink Fail = #inline {
    let buf ^[21]i8 = use regions.ref(---)

    let remaining = use regions.ref(abs(n))

    let start size = handle {
        for(21, 1) { current ->
            buf[current]^ = '0' + #trunc (remaining^ % 10)
            remaining^ /= 10
            if remaining^ == 0 {
                yeet current
            }
        }
        unreachable
    }

    write_all(if n < 0 {
        buf[start - 1]^ = '-'
        buf[start - 1..]
    } else {
        buf[start..]
    })
}

fun print[r](bytes str[r,]) with StdIo = {
    use stdout
    try write_all(bytes)
}

fun eprint[r](bytes str[r,]) with StdIo = {
    use stderr
    try write_all(bytes)
}

fun println with StdIo = {
    use stdout
    try writeln
}

fun eprintln with StdIo = {
    use stderr
    try writeln
}

fun print_int(n int) with StdIo = {
    use stdout
    try write_int(n)
}

fun eprint_int(n int) with StdIo = {
    use stderr
    try write_int(n)
}

effect StdIo = {
    fun stdin(fun body with Source)
    fun stdout(fun body with Sink)
    fun stderr(fun body with Sink)
}

fun buffered_sink[mut r](buffer str[r,], fun body with Sink) with Sink Fail = #inline {
    let current ^size = use regions.ref(0)
    handle body with Sink {
        fun write[r](bytes str[r,]) size = {
            for(0, len(bytes)) { i ->
                if current^ == len(buffer) {
                    write_all(buffer)
                    current^ = 0
                }
                buffer[current^]^ = bytes[i]^
                current^ += 1
            }
            len(bytes)
        }
        fun flush = {
            if current^ > 0 {
                write_all(buffer[0..current^])
                current^ = 0
            }
            flush
        }
    }
}
