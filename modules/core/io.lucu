effect Source = {
	fun read() usize with Sink
}

effect Sink = {
	fun write[r](bytes ^@r []u8) usize
	fun flush()
}

fun read_line with Source Sink = {
}

effect StdIo = {
	fun stdin(fun body with Source)
	fun stdout(fun body with Sink)
	fun stderr(fun body with Sink)
}

effect Buffered[E effect] = {
	fun buffered[mut r](
		buffer ^@r []u8,
		fun handled(fun body with E),
		fun body with E,
	)
}

handle Buffered[Source] {
	fun buffered[mut r](
		buffer ^@r []u8,
		fun handled(fun body with Source),
		fun body with Source,
	) = {
		
	}
}
handle Buffered[Sink] {
	fun buffered[mut r](
		buffer ^@r []u8,
		fun handled(fun body with Sink),
		fun body with Sink,
	) = {
		
	}
}
