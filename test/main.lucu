import "core:io"
import "core:env"

fun main with io.StdIo env.Args env.Environ = {
    discard env.next_arg
    if env.next_arg { arg ->
        io.print("Argument: ")
        io.print(cstr_to_str(arg))
        io.println
    }

    if env.has_next_arg {
        io.print("Remaining arguments:")
        io.println
        handle env.remaining_args with Yield[cstr[static,],] {
            fun yield(arg cstr[static,]) = {
                io.print("  ")
                io.print(cstr_to_str(arg))
                io.println
            }
        }
    }

    if env.get("HOME") { var ->
        io.print("Your home directory is: ")
        io.print(cstr_to_str(var))
        io.println
    }
}
