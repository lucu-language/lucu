import "builtin:regions"
import "core:io"
import "os:linux"

fun dec(n size, stride size) size = if n == 0 then stride - 1 else n - 1
fun inc(n size, stride size) size = if n == stride - 1 then 0 else n + 1

fun write_state(state ^[]i8, stride size) with io.Sink Fail = #inline {
    io.write_all("-")
    for(0, stride) { x ->
        io.write_all("--")
    }
    io.write_all("-")
    io.writeln

    for(0, stride) { y ->
        io.write_all("|")
        for(0, stride) { x ->
            io.write_all(if state[x + y * stride]^ == 1 then "[]" else "  ")
        }
        io.write_all("|")
        io.writeln
    }

    io.write_all("-")
    for(0, stride) { x ->
        io.write_all("--")
    }
    io.write_all("-")
    io.writeln
}

fun clear_state(state ^mut []i8, stride size) = {
    for(0, stride) { y ->
        for(0, stride) { x ->
            state[x + y * stride]^ = 0
        }
    }
}

fun next_state(old ^[]i8, new ^mut []i8, stride size) = {
    for(0, stride) { y ->
        for(0, stride) { x ->
            let neighbors ^size = use regions.ref(0)

            if old[dec(x, stride) + dec(y, stride) * stride]^ == 1 then neighbors^ += 1
            if old[    x          + dec(y, stride) * stride]^ == 1 then neighbors^ += 1
            if old[inc(x, stride) + dec(y, stride) * stride]^ == 1 then neighbors^ += 1
            if old[dec(x, stride) +     y          * stride]^ == 1 then neighbors^ += 1
            if old[inc(x, stride) +     y          * stride]^ == 1 then neighbors^ += 1
            if old[dec(x, stride) + inc(y, stride) * stride]^ == 1 then neighbors^ += 1
            if old[    x          + inc(y, stride) * stride]^ == 1 then neighbors^ += 1
            if old[inc(x, stride) + inc(y, stride) * stride]^ == 1 then neighbors^ += 1

            new[x + y * stride]^ = if old[x + y * stride]^ == 1 {
                if neighbors^ == 2 {
                    1
                } else if neighbors^ == 3 {
                    1
                } else {
                    0
                }
            } else if neighbors^ == 3 {
                1
            } else {
                0
            }
        }
    }
}

fun main(stride size) with Div io.StdIo linux.Syscall = #inline {
    use io.stdin
    use io.stdout

    -- create buffers
    let board_a ^[]i8 = use regions.alloca(stride * stride)
    let board_b ^[]i8 = use regions.alloca(stride * stride)

    -- init state
    if true {
        -- random
        discard linux.getrandom(board_a)
        for(0, len(board_a)) { i ->
            board_a[i]^ &= 1
        }
    } else {
        -- glider
        clear_state(board_a, stride)
        board_a[0 + 0 * stride]^ = 1
        board_a[1 + 1 * stride]^ = 1
        board_a[2 + 1 * stride]^ = 1
        board_a[0 + 2 * stride]^ = 1
        board_a[1 + 2 * stride]^ = 1
    }

    loop {
        try write_state(board_a, stride)
        io.flush
        discard io.skip_line
        next_state(board_a, board_b, stride)
        try write_state(board_b, stride)
        io.flush
        discard io.skip_line
        next_state(board_b, board_a, stride)
    }
}
