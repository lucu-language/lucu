import "types"
import "regions"

type u8 = types.u8
type u16 = types.u16
type u32 = types.u32
type u64 = types.u64

type uint = types.uint
type uaddr = types.uaddr
type usize = types.usize

type i8 = types.i8
type i16 = types.i16
type i32 = types.i32
type i64 = types.i64

type int = types.int
type addr = types.addr
type size = types.size

type bool = types.bool
type unit = types.unit

const true bool = types.true
const false bool = types.false

type nullptr = types.nullptr

type str[r] = ^@r []i8
type cstr[r] = ^@r [:0]i8

-- regions

region static = regions.static
region heap = regions.heap

effect Read[r] = regions.Read[r,]
effect Write[r] = regions.Write[r,]

-- fun ref[T, U](val T, fun body(ptr ^mut T) U) U
-- 	= regions.ref[T, U](val, body)

-- source location

type SourceLocation = struct(
    path str[static,],
    line int,
    column int,
)

effect CallerLocation = {
    fun caller SourceLocation
}

handle CallerLocation {
    fun caller SourceLocation
        = #intrinsic
}

-- world

effect World
    = #intrinsic

fun link[LIB str[static,], E effect](fun body with E) with World
    = #intrinsic

fun asm[ASSEMBLY str[static,], CONSTRAINTS str[static,], T, U](t T) U with World
    = #intrinsic

fun asm_pure[ASSEMBLY str[static,], CONSTRAINTS str[static,], T, U](t T) U
    = #intrinsic

-- printing

fun trace[r](buf str[r,])
    = #intrinsic

fun trap !
    = #intrinsic

fun traceln = {
    let buf ^[1]i8 = use regions.ref([10])
    trace(buf[..])
}

fun trace_int(n int) = {
    let buf ^[21]i8 = use regions.ref(---)

    let remaining = use regions.ref(abs(n))

    let start size = handle {
        for(21, 1) { current ->
            buf[current]^ = '0' + #trunc (remaining^ % 10)
            remaining^ /= 10
            if remaining^ == 0 {
                yeet current
            }
        }
        unreachable
    }

    trace(if n < 0 {
        buf[start - 1]^ = '-'
        buf[start - 1..]
    } else {
        buf[start..]
    })
}

fun assert[r](condition bool, msg str[r,]) with CallerLocation = {
    if !condition {
        panic(msg)
    }
}

fun panic[r](msg str[r,]) ! with CallerLocation = {
    trace((caller).path)
    trace(":")
    trace_int((caller).line)
    trace(":")
    trace_int((caller).column)
    trace(": PANIC: ")
    trace(msg)
    traceln
    trap
}

fun todo[r](msg str[r,]) ! with CallerLocation = {
    trace((caller).path)
    trace(":")
    trace_int((caller).line)
    trace(":")
    trace_int((caller).column)
    trace(": TODO: ")
    trace(msg)
    traceln
    trap
}

-- control flow

effect Div
    = #intrinsic

fun loop(fun body) ! with Div
    = #intrinsic

fun unfounded[T](fun body T with Div) T
    = #intrinsic

fun for(from size, to size, fun body(n size)) = #inline {
    if to >= from {
        let current = use regions.ref(from)
        handle unfounded loop {
            if current^ == to then raise
            body(current^)
            current^ += 1
        }
    } else {
        let current = use regions.ref(from - 1)
        handle unfounded loop {
            body(current^)
            current^ -= 1
            if current^ == to then raise
        }
    }
}

fun unreachable !
    = #intrinsic

fun while(fun cond bool, fun body) with Div = #inline {
    handle loop {
        if !cond then raise
        body
    }
}

fun until(fun cond bool, fun body) with Div = #inline {
    handle loop {
        if cond then raise
        body
    }
}

-- intrinsics that could be defined in-language one day

fun len[T](slice ^#raw []T) size
    = #intrinsic

fun slice_from_raw_parts[#raw r, T](ptr ^@r T, length size) ^@r []T
    = #intrinsic

fun some[T](t T) ?T
    = #intrinsic

fun none[T] ?T
    = #intrinsic

-- other utils (should be moved outside of builtin at some point)

effect Yield[T] = {
    fun yield(t T)
}

effect Fail = {
    fun fail !
}

fun try(fun body with Fail) = #inline handle body with Fail {
    fun fail ! = raise
}

fun abs(n int) int = if n >= 0 then n else -n

fun and(a bool, b bool) bool = if a then b else false

fun str_eq[r](a str[r,], b str[r,]) bool = {
    if len(a) != len(b) {
        false
    } else handle {
        for(0, len(a)) { current ->
            if a[current]^ != b[current]^ {
                raise false
            }
        }
        true
    }
}

fun strlen[r](str cstr[r,]) size = {
    let len ^size = use regions.ref(0)
    unfounded until(str[len^]^ == 0) {
        len^ += 1
    }
    len^
}

fun cstr_to_str[r](str cstr[r,]) str[r,] = {
    let len = strlen(str)
    slice_from_raw_parts(str[0], len)
}

