effect Source = {
	fun read() usize with Sink
}

effect Sink = {
	fun write[R region](bytes ^@R []u8) usize with Read[R]
	fun flush()
}

effect Buffered[E effect] = {
	fun buffered[R region](
		buffer ^@R []u8,
		fun handled(fun body with E),
		fun body with E,
	) with Read[R] Write[R]
}

-- default Buffered[Source]
-- default Buffered[Sink]
