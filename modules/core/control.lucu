-- taken almost directly from haskell

effect Functor0[M[_]] = {
   fun fmap[A, B](a M[A], fun body(a A) B) M[B]
}

effect Applicative0[M[_]] = {
   fun pure[A](a A) M[A]
   fun lift_a2[A, B, C](lhs M[A], rhs M[B], fun binop(a A, b B) C) M[C]
}

effect Monad0[M[_]] = {
   fun return_[A](a A) M[A]
   fun bind[A, B](a M[A], fun body(a A) M[B]) M[B]
}

-- alright, now let's define them more *sensibly*

type Pair[A, B] = struct(left A, right B)

effect Wrap[M[_] thunk] = {
   fun wrap[A](a A) M[A]
}

effect Map[M[_] thunk] = {
   fun map[A, B](fun f(a A) B, fun ma M[A]) M[B]
}

effect CrossMap[M[_] thunk] = {
   fun cross_map[A, B, C](fun f(lhs A, rhs B) C, fun ma M[A], fun mb M[B]) M[C]
}

fun cross[M[_] thunk, A, B](fun ma M[A], fun mb M[B]) M[Pair[A, B]] with CrossMap[M] = {
   cross_map({ a, b -> Pair(a, b) }, lhs, rhs)
}

effect FlatMap[M[_] thunk] = {
   fun flat_map[A, B](fun f(a A) M[B], fun ma M[A]) M[B]
}

fun flatten[M[_] type, A](mma M[M[A]]) M[A] with FlatMap[M] = {
   flat_map({ ma -> ma }, mma)
}

effect Functor[M[_] thunk] = Map[M]
effect Applicative[M[_] thunk] = Wrap[M] CrossMap[M]
effect Monad[M[_] thunk] = Wrap[M] FlatMap[M]
