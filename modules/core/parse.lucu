import "builtin:regions"
import "builtin:types"

effect Parse[T] = {
    fun from_str[r](s str[r]) T with Fail
}

handle Parse[int] {
    fun from_str[r](s str[r]) int with Fail = {
        let out = use regions.ref(0)
        let negative = s[0]^ == '-'
        for(if negative then 1 else 0, len(s)) { i ->
            let char = s[i]^
            if char != '_' {
                if char < '0' or char > '9' then fail
                let old = out^
                out^ *= 10
                out^ -= #ext (char - '0')
                -- check for overflow
                if out^ > old then fail
            }
        }
        if negative then out^ else {
            if out^ == types.INT_MIN then fail
            -out^
        }
    }
}

handle Parse[bool] {
    fun from_str[r](s str[r]) bool with Fail = {
        if str_eq(s, "true") {
            true
        } else if str_eq(s, "false") {
            false
        } else {
            fail
        }
    }
}
