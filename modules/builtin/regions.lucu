region static
   = #intrinsic

region heap
   = #intrinsic

effect Read[r]
   = #intrinsic

effect Write[r]
   = #intrinsic

fun ref[T, U](val T, fun body(ptr ^mut T) U) U
   = #intrinsic

fun alloca[T, U](len usize, fun body(slice ^mut []T) U) U
   = #intrinsic

